<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<RootNamespace>BuckarooSdk</RootNamespace>
		<AssemblyName>BuckarooSdk</AssemblyName>
		<Description>.NET Standard SDK for the Buckaroo API</Description>
		<PackageId>BuckarooSdk</PackageId>
		<Authors>Buckaroo</Authors>
		<Company>Buckaroo</Company>
		<Copyright>Copyright © Buckaroo</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/buckaroo-it/BuckarooSdk_DotNet</PackageProjectUrl>
		<RepositoryUrl>https://github.com/buckaroo-it/BuckarooSdk_DotNet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>buckaroo;payments;payment;psp;ideal;creditcard;sdk</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="/" />
		<None Include="../LICENSE" Pack="true" PackagePath="/" />
		<None Include="icon.png" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="DataTypes\GlobalGroups\" />
		<Folder Include="Services\CreditCards\BanContact\Constants\" />
		<Folder Include="Services\CreditManagement\Push\" />
		<Folder Include="Services\iDin\Constants\" />
		<Folder Include="Services\iDin\DataRequest\" />
		<Folder Include="Services\Payconiq\Push\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Expose internal types (Service, RequestParameter, ServiceHelper, Request, ...) to the
		     unit test project so request-building and serialization can be verified without network. -->
		<InternalsVisibleTo Include="BuckarooSdk.UnitTests" />
	</ItemGroup>

</Project>